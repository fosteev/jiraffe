{
  "name": "jiraffe",
  "displayName": "Jiraffe",
  "description": "Jira в VS Code: задачи, фильтры, карточка, журнал работ, эпики и релизы",
  "version": "0.2.0",
  "publisher": "jiraffe",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fosteev/jiraffe.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Jiraffe ходит в Jira с вашим токеном и сохраняет вложения в папку рабочей области — только в доверенных папках."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jiraffe",
          "title": "Jiraffe",
          "icon": "media/jiraffe.svg"
        }
      ]
    },
    "views": {
      "jiraffe": [
        {
          "id": "jiraffe.issues",
          "name": "Задачи"
        },
        {
          "id": "jiraffe.filters",
          "name": "Фильтры"
        },
        {
          "id": "jiraffe.epics",
          "name": "Эпики"
        },
        {
          "id": "jiraffe.releases",
          "name": "Релизы"
        },
        {
          "id": "jiraffe.tempo",
          "name": "Tempo",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "jiraffe.refresh",
        "title": "Jiraffe: Обновить",
        "icon": "$(refresh)"
      },
      {
        "command": "jiraffe.addInstance",
        "title": "Jiraffe: Добавить инстанс"
      },
      {
        "command": "jiraffe.scopeInstances",
        "title": "Jiraffe: Инстансы этого workspace",
        "icon": "$(server-environment)"
      },
      {
        "command": "jiraffe.removeInstance",
        "title": "Jiraffe: Удалить инстанс"
      },
      {
        "command": "jiraffe.testConnection",
        "title": "Jiraffe: Проверить подключение"
      },
      {
        "command": "jiraffe.refreshCapabilities",
        "title": "Jiraffe: Обновить возможности инстанса"
      },
      {
        "command": "jiraffe.setMode",
        "title": "Jiraffe: Режим списка (на мне / проект / JQL)",
        "icon": "$(list-selection)"
      },
      {
        "command": "jiraffe.pickProject",
        "title": "Jiraffe: Выбрать проект",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.quickFilters",
        "title": "Jiraffe: Быстрые фильтры",
        "icon": "$(filter)"
      },
      {
        "command": "jiraffe.editJql",
        "title": "Jiraffe: Редактировать JQL",
        "icon": "$(code)"
      },
      {
        "command": "jiraffe.search",
        "title": "Jiraffe: Поиск по тексту или ключу",
        "icon": "$(search)"
      },
      {
        "command": "jiraffe.resetFilters",
        "title": "Jiraffe: Сбросить фильтры",
        "icon": "$(clear-all)"
      },
      {
        "command": "jiraffe.saveFilter",
        "title": "Jiraffe: Сохранить как фильтр",
        "icon": "$(save)"
      },
      {
        "command": "jiraffe.deleteFilter",
        "title": "Jiraffe: Удалить фильтр",
        "icon": "$(trash)"
      },
      {
        "command": "jiraffe.applyFilter",
        "title": "Jiraffe: Применить фильтр"
      },
      {
        "command": "jiraffe.loadMore",
        "title": "Jiraffe: Загрузить ещё"
      },
      {
        "command": "jiraffe.openIssue",
        "title": "Jiraffe: Открыть задачу"
      },
      {
        "command": "jiraffe.openIssueByKey",
        "title": "Jiraffe: Открыть задачу по ключу"
      },
      {
        "command": "jiraffe.pinIssue",
        "title": "Jiraffe: Закрепить карточку задачи"
      },
      {
        "command": "jiraffe.copyKey",
        "title": "Jiraffe: Копировать ключ задачи"
      },
      {
        "command": "jiraffe.openInBrowser",
        "title": "Jiraffe: Открыть задачу в Jira"
      },
      {
        "command": "jiraffe.logWork",
        "title": "Jiraffe: Залогать время",
        "icon": "$(clock)"
      },
      {
        "command": "jiraffe.transition",
        "title": "Jiraffe: Сменить статус",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "jiraffe.openEpic",
        "title": "Jiraffe: Открыть эпик"
      },
      {
        "command": "jiraffe.openRelease",
        "title": "Jiraffe: Открыть релиз"
      },
      {
        "command": "jiraffe.downloadAttachment",
        "title": "Jiraffe: Скачать вложение"
      },
      {
        "command": "jiraffe.pickEpicProject",
        "title": "Jiraffe: Выбрать проект эпиков",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.pickReleaseProject",
        "title": "Jiraffe: Выбрать проект релизов",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.loadMoreEpics",
        "title": "Jiraffe: Загрузить ещё эпики"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jiraffe.applyFilter",
          "when": "false"
        },
        {
          "command": "jiraffe.loadMore",
          "when": "false"
        },
        {
          "command": "jiraffe.openIssue",
          "when": "false"
        },
        {
          "command": "jiraffe.deleteFilter",
          "when": "false"
        },
        {
          "command": "jiraffe.openEpic",
          "when": "false"
        },
        {
          "command": "jiraffe.openRelease",
          "when": "false"
        },
        {
          "command": "jiraffe.downloadAttachment",
          "when": "false"
        },
        {
          "command": "jiraffe.loadMoreEpics",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "jiraffe.search",
          "when": "view == jiraffe.issues",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.quickFilters",
          "when": "view == jiraffe.issues",
          "group": "navigation@2"
        },
        {
          "command": "jiraffe.setMode",
          "when": "view == jiraffe.issues",
          "group": "navigation@3"
        },
        {
          "command": "jiraffe.refresh",
          "when": "view == jiraffe.issues || view == jiraffe.filters || view == jiraffe.epics || view == jiraffe.releases",
          "group": "navigation@9"
        },
        {
          "command": "jiraffe.scopeInstances",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "navigation@8"
        },
        {
          "command": "jiraffe.addInstance",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@1"
        },
        {
          "command": "jiraffe.testConnection",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@2"
        },
        {
          "command": "jiraffe.removeInstance",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@3"
        },
        {
          "command": "jiraffe.pickProject",
          "when": "view == jiraffe.issues",
          "group": "1_filters@1"
        },
        {
          "command": "jiraffe.editJql",
          "when": "view == jiraffe.issues",
          "group": "1_filters@2"
        },
        {
          "command": "jiraffe.saveFilter",
          "when": "view == jiraffe.issues",
          "group": "1_filters@3"
        },
        {
          "command": "jiraffe.resetFilters",
          "when": "view == jiraffe.issues",
          "group": "1_filters@4"
        },
        {
          "command": "jiraffe.saveFilter",
          "when": "view == jiraffe.filters",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.logWork",
          "when": "view == jiraffe.tempo",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.refresh",
          "when": "view == jiraffe.tempo",
          "group": "navigation@2"
        },
        {
          "command": "jiraffe.pickEpicProject",
          "when": "view == jiraffe.epics",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.pickReleaseProject",
          "when": "view == jiraffe.releases",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "jiraffe.deleteFilter",
          "when": "view == jiraffe.filters && viewItem == localFilter",
          "group": "inline"
        },
        {
          "command": "jiraffe.deleteFilter",
          "when": "view == jiraffe.filters && viewItem == localFilter",
          "group": "1_edit"
        },
        {
          "command": "jiraffe.logWork",
          "when": "view == jiraffe.issues && viewItem == issue",
          "group": "1_work@1"
        },
        {
          "command": "jiraffe.transition",
          "when": "view == jiraffe.issues && viewItem == issue",
          "group": "1_work@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jiraffe.issues",
        "contents": "Нет инстансов Jira для этого workspace.\n[Добавить инстанс](command:jiraffe.addInstance)\n[Выбрать из подключённых](command:jiraffe.scopeInstances)"
      },
      {
        "view": "jiraffe.epics",
        "contents": "Нет инстансов Jira для этого workspace.\n[Добавить инстанс](command:jiraffe.addInstance)\n[Выбрать из подключённых](command:jiraffe.scopeInstances)"
      },
      {
        "view": "jiraffe.releases",
        "contents": "Нет инстансов Jira для этого workspace.\n[Добавить инстанс](command:jiraffe.addInstance)\n[Выбрать из подключённых](command:jiraffe.scopeInstances)"
      }
    ],
    "configuration": {
      "title": "Jiraffe",
      "properties": {
        "jiraffe.instances": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "window",
          "markdownDescription": "Какие инстансы показывать в этом workspace: id или адрес инстанса (`https://jira.example.com`). Не задано или пусто — все подключённые. Удобно класть в `.vscode/settings.json` папки проекта; выбрать мышкой — команда **Jiraffe: Инстансы этого workspace**. Подключения и токены при этом общие для всех окон."
        },
        "jiraffe.maxResults": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "description": "Сколько задач загружать за один запрос (и по кнопке «Загрузить ещё»)."
        },
        "jiraffe.attachmentsDir": {
          "type": "string",
          "default": ".jiraffe",
          "description": "Куда сохранять вложения: путь относительно первой папки рабочей области (внутри неё), вложения задачи — в подпапке <KEY>. Абсолютный путь — только из пользовательских настроек. Без открытой папки — временный каталог (<tmp>/jiraffe, очищается через неделю)."
        },
        "jiraffe.maxImageMb": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "Максимальный размер картинки (МБ), которую карточка скачивает для превью и показа в описании. Больше — только «Скачать»."
        },
        "jiraffe.workdayHours": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 24,
          "description": "Длина рабочего дня в часах: знаменатель сводки «Сегодня 3ч 15м / 8ч» в разделе Tempo и строке состояния."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "sanitize-html": "^2.18.0"
  }
}
