{
  "name": "jiraffe",
  "displayName": "Jiraffe",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "jiraffe",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fosteev/jiraffe.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jiraffe",
          "title": "Jiraffe",
          "icon": "media/jiraffe.svg"
        }
      ]
    },
    "views": {
      "jiraffe": [
        {
          "id": "jiraffe.issues",
          "name": "%view.issues%"
        },
        {
          "id": "jiraffe.filters",
          "name": "%view.filters%"
        },
        {
          "id": "jiraffe.epics",
          "name": "%view.epics%"
        },
        {
          "id": "jiraffe.releases",
          "name": "%view.releases%"
        },
        {
          "id": "jiraffe.tempo",
          "name": "Tempo",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "jiraffe.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "jiraffe.addInstance",
        "title": "%command.addInstance%"
      },
      {
        "command": "jiraffe.scopeInstances",
        "title": "%command.scopeInstances%",
        "icon": "$(server-environment)"
      },
      {
        "command": "jiraffe.removeInstance",
        "title": "%command.removeInstance%"
      },
      {
        "command": "jiraffe.testConnection",
        "title": "%command.testConnection%"
      },
      {
        "command": "jiraffe.refreshCapabilities",
        "title": "%command.refreshCapabilities%"
      },
      {
        "command": "jiraffe.setMode",
        "title": "%command.setMode%",
        "icon": "$(list-selection)"
      },
      {
        "command": "jiraffe.pickProject",
        "title": "%command.pickProject%",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.quickFilters",
        "title": "%command.quickFilters%",
        "icon": "$(filter)"
      },
      {
        "command": "jiraffe.editJql",
        "title": "%command.editJql%",
        "icon": "$(code)"
      },
      {
        "command": "jiraffe.search",
        "title": "%command.search%",
        "icon": "$(search)"
      },
      {
        "command": "jiraffe.resetFilters",
        "title": "%command.resetFilters%",
        "icon": "$(clear-all)"
      },
      {
        "command": "jiraffe.saveFilter",
        "title": "%command.saveFilter%",
        "icon": "$(save)"
      },
      {
        "command": "jiraffe.deleteFilter",
        "title": "%command.deleteFilter%",
        "icon": "$(trash)"
      },
      {
        "command": "jiraffe.applyFilter",
        "title": "%command.applyFilter%"
      },
      {
        "command": "jiraffe.loadMore",
        "title": "%command.loadMore%"
      },
      {
        "command": "jiraffe.openIssue",
        "title": "%command.openIssue%"
      },
      {
        "command": "jiraffe.openIssueByKey",
        "title": "%command.openIssueByKey%"
      },
      {
        "command": "jiraffe.pinIssue",
        "title": "%command.pinIssue%"
      },
      {
        "command": "jiraffe.copyKey",
        "title": "%command.copyKey%"
      },
      {
        "command": "jiraffe.openInBrowser",
        "title": "%command.openInBrowser%"
      },
      {
        "command": "jiraffe.logWork",
        "title": "%command.logWork%",
        "icon": "$(clock)"
      },
      {
        "command": "jiraffe.transition",
        "title": "%command.transition%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "jiraffe.openEpic",
        "title": "%command.openEpic%"
      },
      {
        "command": "jiraffe.openRelease",
        "title": "%command.openRelease%"
      },
      {
        "command": "jiraffe.downloadAttachment",
        "title": "%command.downloadAttachment%"
      },
      {
        "command": "jiraffe.pickEpicProject",
        "title": "%command.pickEpicProject%",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.pickReleaseProject",
        "title": "%command.pickReleaseProject%",
        "icon": "$(project)"
      },
      {
        "command": "jiraffe.loadMoreEpics",
        "title": "%command.loadMoreEpics%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jiraffe.applyFilter",
          "when": "false"
        },
        {
          "command": "jiraffe.loadMore",
          "when": "false"
        },
        {
          "command": "jiraffe.openIssue",
          "when": "false"
        },
        {
          "command": "jiraffe.deleteFilter",
          "when": "false"
        },
        {
          "command": "jiraffe.openEpic",
          "when": "false"
        },
        {
          "command": "jiraffe.openRelease",
          "when": "false"
        },
        {
          "command": "jiraffe.downloadAttachment",
          "when": "false"
        },
        {
          "command": "jiraffe.loadMoreEpics",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "jiraffe.search",
          "when": "view == jiraffe.issues",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.quickFilters",
          "when": "view == jiraffe.issues",
          "group": "navigation@2"
        },
        {
          "command": "jiraffe.setMode",
          "when": "view == jiraffe.issues",
          "group": "navigation@3"
        },
        {
          "command": "jiraffe.refresh",
          "when": "view == jiraffe.issues || view == jiraffe.filters || view == jiraffe.epics || view == jiraffe.releases",
          "group": "navigation@9"
        },
        {
          "command": "jiraffe.scopeInstances",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "navigation@8"
        },
        {
          "command": "jiraffe.addInstance",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@1"
        },
        {
          "command": "jiraffe.testConnection",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@2"
        },
        {
          "command": "jiraffe.removeInstance",
          "when": "view == jiraffe.issues || view == jiraffe.filters",
          "group": "2_instances@3"
        },
        {
          "command": "jiraffe.pickProject",
          "when": "view == jiraffe.issues",
          "group": "1_filters@1"
        },
        {
          "command": "jiraffe.editJql",
          "when": "view == jiraffe.issues",
          "group": "1_filters@2"
        },
        {
          "command": "jiraffe.saveFilter",
          "when": "view == jiraffe.issues",
          "group": "1_filters@3"
        },
        {
          "command": "jiraffe.resetFilters",
          "when": "view == jiraffe.issues",
          "group": "1_filters@4"
        },
        {
          "command": "jiraffe.saveFilter",
          "when": "view == jiraffe.filters",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.logWork",
          "when": "view == jiraffe.tempo",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.refresh",
          "when": "view == jiraffe.tempo",
          "group": "navigation@2"
        },
        {
          "command": "jiraffe.pickEpicProject",
          "when": "view == jiraffe.epics",
          "group": "navigation@1"
        },
        {
          "command": "jiraffe.pickReleaseProject",
          "when": "view == jiraffe.releases",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "jiraffe.deleteFilter",
          "when": "view == jiraffe.filters && viewItem == localFilter",
          "group": "inline"
        },
        {
          "command": "jiraffe.deleteFilter",
          "when": "view == jiraffe.filters && viewItem == localFilter",
          "group": "1_edit"
        },
        {
          "command": "jiraffe.logWork",
          "when": "view == jiraffe.issues && viewItem == issue",
          "group": "1_work@1"
        },
        {
          "command": "jiraffe.transition",
          "when": "view == jiraffe.issues && viewItem == issue",
          "group": "1_work@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jiraffe.issues",
        "contents": "%welcome.noInstances%"
      },
      {
        "view": "jiraffe.epics",
        "contents": "%welcome.noInstances%"
      },
      {
        "view": "jiraffe.releases",
        "contents": "%welcome.noInstances%"
      }
    ],
    "configuration": {
      "title": "Jiraffe",
      "properties": {
        "jiraffe.instances": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "window",
          "markdownDescription": "%config.instances%"
        },
        "jiraffe.maxResults": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.maxResults%"
        },
        "jiraffe.attachmentsDir": {
          "type": "string",
          "default": ".jiraffe",
          "description": "%config.attachmentsDir%"
        },
        "jiraffe.maxImageMb": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.maxImageMb%"
        },
        "jiraffe.workdayHours": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 24,
          "description": "%config.workdayHours%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "sanitize-html": "^2.18.0"
  }
}
